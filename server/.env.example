# CareCircle AWS Hackathon Environment Configuration

# Server Settings
PORT=3000
GRACE_SECONDS=20

# Custom Domain Configuration
CUSTOM_DOMAIN=carecircle.app
AWS_REGION=us-east-1

# Telegram Caregiver Alert Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AWS Bedrock Credentials (AWS Builder Track Prize)
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Firebase Realtime Database Configuration
FIREBASE_DATABASE_URL=https://carecircle-hackathon-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
